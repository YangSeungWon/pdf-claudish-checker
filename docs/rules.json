        ", not [a-z][a-z ]{0,40}[.]$",
        "\\bnot (?:whether|that|about|because of) [^.;:]{1,60}?\\bbut\\b",
        "\\bnot so much [^.;:]{1,50}?\\bas\\b",
        "^far from (?:being )?[^.;:]{1,50},",
        "^rather than [^.;:]{1,60},",
        "\\bit would be a mistake to\\b",
        "\\bit(?:'?s| is) tempting to [^.;:]{1,60}?\\bbut\\b",
        "\\bthe point is not\\b"
